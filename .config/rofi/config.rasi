@import "colors-matugen.rasi"
configuration {
    modi: "drun,run,window";
    lines: 6;
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "alacritty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    hide-scrollbar: true;
    display-drun: "   Apps";
    display-run: "   Run";
    display-window: "   Window";
    sidebar-mode: true;
}

* {
    bg-col:  #1e1e2e;
    border-col: #89b4fa;
    selected-col: #313244;
    blue: #89b4fa;
    fg-col: #cdd6f4;
    grey: #6c7086;
    width: 620px;
}

element-text, element-icon, mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    height: 360px;
    border: 2px;
    border-color: @border-col;
    border-radius: 10px;
    background-color: @bg-col;
}

mainbox {
    background-color: @bg-col;
    padding: 10px;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 6px;
    padding: 2px;
}

prompt {
    background-color: @blue;
    padding: 6px 12px;
    text-color: @bg-col;
    border-radius: 6px;
    margin: 10px 0px 0px 10px;
}

entry {
    padding: 6px 10px;
    margin: 10px 10px 0px 10px;
    text-color: @fg-col;
    background-color: @selected-col;
    border-radius: 6px;
    placeholder: "Search applications...";
    placeholder-color: @grey;
}

listview {
    border: 0px;
    padding: 6px 0px 0px;
    margin: 10px 10px 0px 10px;
    columns: 2;
    lines: 5;
    background-color: @bg-col;
}

element {
    padding: 8px;
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 6px;
}

element-icon {
    size: 24px;
    padding: 0px 8px 0px 0px;
}

element selected {
    background-color: @selected-col;
    text-color: @blue;
    border: 1px;
    border-color: @blue;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 6px 10px;
    background-color: @bg-col;
    text-color: @grey;
    vertical-align: 0.5; 
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @blue;
}
