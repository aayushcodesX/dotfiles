[global]
    width = 300
    height = 200
    offset = 20x45
    origin = top-right
    transparency = 10
    corner_radius = 8
    frame_color = "#89b4fa"
    frame_width = 2
    font = JetBrainsMono Nerd Font 9
    padding = 10
    horizontal_padding = 12

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 3

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
