#!/usr/bin/env bash
WALLPAPER="$1"

if [ -z "$WALLPAPER" ] || [ ! -f "$WALLPAPER" ]; then
    echo "Usage: set-wallpaper /path/to/image.jpg"
    exit 1
fi

# 1. Apply wallpaper with feh
feh --bg-fill "$WALLPAPER"

# 2. Extract Material 3 colors with matugen (dark mode)
matugen image "$WALLPAPER" -m dark

# 3. Restart Polybar with new colors
~/.config/polybar/launch.sh

# 4. Update i3 active border to match primary accent color
ACCENT=$(grep "blue = " ~/.config/polybar/colors-matugen.ini | cut -d' ' -f3)
i3-msg "client.focused $ACCENT #1e1e2e #cdd6f4 $ACCENT $ACCENT" > /dev/null
